# Konfiguracja Konta sudomie. Kopia: cp .env.example .env
# Komentarz MUSI stać w osobnej linii — w plikach .env nie ma komentarzy w linii z wartością.

# --- Django ---
DJANGO_DEBUG=0
# python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=konto.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://konto.example.com
DJANGO_SSL_REDIRECT=1
# 31536000 dopiero, gdy HTTPS działa bez problemów przez tydzień
DJANGO_HSTS_SEKUNDY=300
HTTP_PORT=127.0.0.1:8097

# --- dane (w kontenerze na wolumenie /data) ---
DJANGO_DB_PATH=/data/db.sqlite3

# --- klucz podpisujący tokeny OIDC ---
# tworzy go deploy/oidc-klucz.sh; zmiana klucza wylogowuje wszystkich we wszystkich produktach
OIDC_KLUCZ_PLIK=/run/oidc/klucz.pem

# --- poczta (zaproszenia, potwierdzenia, reset hasła) ---
EMAIL_HOST=mail.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Konto sudomie <no-reply@example.com>

# --- zachowanie ---
ZAPROSZENIE_DNI=7
SESSION_DNI=14
# 1 = publiczny formularz /rejestracja/ (firmy zakładają się same)
REJESTRACJA_WLACZONA=0
REJESTRACJA_NA_GODZINE=5
REJESTRACJA_MAX_OCZEKUJACYCH=200
LIMIT_LOGOWAN_NA_MINUTE=10
LIMIT_RESETOW_NA_GODZINE=5
# G-XXXXXXXXXX = tag GA4 na ekranach publicznych
GA_MEASUREMENT_ID=
