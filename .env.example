# Konfiguracja Konta sudomie. Kopia: cp .env.example .env (compose czyta .env).

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=                     # python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=konto.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://konto.example.com
DJANGO_SSL_REDIRECT=1                  # razem z SECURE_PROXY_SSL_HEADER (w kodzie), gdy TLS kończy proxy
DJANGO_HSTS_SEKUNDY=300                # 31536000 dopiero, gdy HTTPS działa bez problemów przez tydzień
HTTP_PORT=127.0.0.1:8097

# --- dane ---
DJANGO_DB_PATH=/data/db.sqlite3

# --- klucz podpisujący tokeny OIDC (RAZ, deploy/oidc-klucz.sh) ---
# zmiana klucza unieważnia tokeny we wszystkich produktach
OIDC_KLUCZ_PLIK=/run/oidc/klucz.pem

# --- poczta (zaproszenia, potwierdzenia, reset hasła) ---
EMAIL_HOST=mail.example.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Konto sudomie <no-reply@example.com>

# --- zachowanie ---
ZAPROSZENIE_DNI=7
SESSION_DNI=14
REJESTRACJA_WLACZONA=0                 # 1 = publiczny formularz /rejestracja/ (zakłada firmy)
REJESTRACJA_NA_GODZINE=5
REJESTRACJA_MAX_OCZEKUJACYCH=200
LIMIT_LOGOWAN_NA_MINUTE=10
LIMIT_RESETOW_NA_GODZINE=5
GA_MEASUREMENT_ID=                     # G-XXXXXXXXXX = tag GA4 na ekranach publicznych
