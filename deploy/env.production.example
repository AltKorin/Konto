EMAIL_HOST=mail.sudomie.pl
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=no-reply@sudomie.pl
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Konto sudomie <no-reply@sudomie.pl>
