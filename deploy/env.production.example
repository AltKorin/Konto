DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-50-random-chars
DJANGO_ALLOWED_HOSTS=konto.sudomie.pl
DJANGO_CSRF_TRUSTED_ORIGINS=https://konto.sudomie.pl
DJANGO_SSL_REDIRECT=1
HTTP_PORT=127.0.0.1:8097
OIDC_KLUCZ_PLIK=/run/oidc/klucz.pem
